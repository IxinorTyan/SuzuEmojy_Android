<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层轻微阴影/描边 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#22000000" />
        </shape>
    </item>
    <!-- 内层主体 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#EAEAEA" />
            <stroke
                android:width="1dp"
                android:color="#44000000" />
        </shape>
    </item>
</layer-list>
