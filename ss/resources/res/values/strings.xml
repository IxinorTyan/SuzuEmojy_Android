    <string name="privacy">Privacy Policy</string>
    <string name="privacy_policy">MyGesture does not declare network permissions and does not collect and upload user privacy data. The following is a description of the purpose of the declared authority:\n\n\n android.permission.VIBRATE:\nGesture feedback\n\n android.permission.SYSTEM_ALERT_WINDOW:\nGesture triggers\n\n android.permission.RECEIVE_BOOT_COMPLETED:\nAuto start gesture on boot\n\n android.permission.ACCESS_NOTIFICATION_POLICY:\nShow breathing lamp for notification\n\n android.permission.ACCESS_WIFI_STATE:\nGesture or panel toggle wifi\n\n android.permission.CHANGE_WIFI_STATE:\nGesture or panel toggle wifi\n\n android.permission.BLUETOOTH:\nGesture or panel toggle bluetooth\n\n android.permission.BLUETOOTH_ADMIN:\nGesture or panel toggle bluetooth\n\n android.permission.READ_PHONE_STATE:\nRead imei for active pro features on local\n\n android.permission.WRITE_EXTERNAL_STORAGE:\nRead wallpaper for panel background, change panel item icon\n\n android.permission.WRITE_SETTINGS:\nChanged the brightness and volume by gesture\n\n</string>
    <string name="privacy_url">https://hisndevelop.github.io/mygesture/mg_privacy.html</string>
