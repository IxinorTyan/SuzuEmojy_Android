<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/theme_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/logo_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/logo_view"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="100dp"
                    android:src="@mipmap/mg_logo_192_r"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/theme_title_color"
                    android:gravity="bottom"
                    android:id="@+id/big_title_bar"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="50dp"
                    android:text="@string/my_gesture"
                    android:layout_below="@+id/logo_view"
                    android:alpha="0"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_text"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/theme_type"
                    android:id="@+id/theme_type_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gesture_switch_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/my_gesture_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/need_permission_text"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_top_bkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:padding="15dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_text"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="?attr/theme_accent_color"
                    android:gravity="end"
                    android:id="@+id/overlay_permission_state"
                    android:background="@drawable/wave_bkg"
                    android:padding="15dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/to_open_text"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:padding="15dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_text"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="?attr/theme_accent_color"
                    android:gravity="end"
                    android:id="@+id/accessibility_permission_state"
                    android:background="@drawable/wave_bkg"
                    android:padding="15dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/to_open_text"
                    android:layout_weight="1"/>
            </LinearLayout>
            <include layout="@layout/more_settings"/>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/setting_text"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:id="@+id/sensitivity_size_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/sensitivity_text"
                    android:layout_weight="1"/>
                <SeekBar
                    android:id="@+id/sensitivity_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:max="4"
                    android:layout_weight="2"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/touch_animation_text"
                    android:layout_weight="1"/>
                <me.hisn.utils.SameSelectedSpinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/edge_anim"
                    android:id="@+id/edge_anim_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/vibrate_settings_btn"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/vibrate_feedback"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:id="@+id/long_press_time_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/long_press_time"
                    android:layout_weight="1"/>
                <SeekBar
                    android:id="@+id/long_press_time_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:max="18"
                    android:layout_weight="2"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hands_up_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/hands_up_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/no_up_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/hands_up_slow_no_up_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/when_land_text"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/landscape_gesture"
                    android:id="@+id/landscape_gesture_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hide_when_soft_input_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/hide_when_soft_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/compat_home"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/compat_home_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hide_trigger_zone_for_1_second_when_click"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/auto_hide_trigger_zone_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_visible_tips"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/edge_visible_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hide_me_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/hide_from_recents_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/optimize_ram_use"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/optimize_ram_use_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/disable_gesture_on_lock_screen"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/disable_gesture_on_lock_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/gesture_blacklist"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/gesture_blacklist_btn"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gesture_black_summary"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/extension_text"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/notification_extension_btn"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/breath_light"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nav_bar_control_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="?attr/theme_item_back_color"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:src="?attr/theme_background_color"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/nav_bar_control_btn"
                    android:background="@drawable/item_bkg"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="?attr/theme_text_color"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/navbar_control"
                        android:layout_weight="1"/>
                    <ImageView
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_expand_more"
                        android:tint="?attr/theme_text_color"
                        android:rotation="-90"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/s_panel_btn"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/about_panel"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/others_title"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/guide_btn"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_setting_text"
                    android:layout_weight="1"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="?attr/theme_accent_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_text"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/privacy_btn"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/crash_log_btn"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/crash_log_text"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_text_color"
                android:gravity="center"
                android:id="@+id/version_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_name"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/theme_text_color"
                android:gravity="center"
                android:id="@+id/count_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/theme_title_color"
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="?attr/theme_background_color"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_gesture"/>
</RelativeLayout>
