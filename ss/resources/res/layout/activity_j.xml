                    android:id="@+id/switch_order_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/switch_black_list_btn"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_black_list"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ex_panel_text"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/panel_settings_btn"
                android:background="@drawable/item_round_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_settings_text"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/backup_restore"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/backup_settings_btn"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_settings_to_storage"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/restore_settings_btn"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_settings_from_storage"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:padding="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/unlock_pro"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/pro_guide_btn"
                android:background="@drawable/item_round_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:id="@+id/get_pro_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/proNwidget_guide"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/active_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/item_top_bkg"
                    android:padding="15dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="?attr/theme_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/imei_title_tv"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/device_code"/>
                    <TextView
                        android:textColor="?attr/theme_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/sn_text"
                        android:padding="15dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/read"
                        android:layout_weight="1"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/split_line"
                    android:background="?attr/theme_item_back_color"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:src="?attr/theme_background_color"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/item_bottom_bkg"
                    android:padding="15dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="?attr/theme_text_color"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/active_code"/>
                    <EditText
                        android:textColor="?attr/theme_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/key_text"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/save_code"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="?attr/theme_accent_color"
                        android:gravity="center"
                        android:id="@+id/save_btn"
                        android:background="@drawable/wave_bkg"
                        android:padding="15dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/save_text"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <me.hisn.utils.ImageTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/theme_title_color"
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="?attr/theme_background_color"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_panel"
        android:drawablePadding="15dp"
        android:alpha="0"
        app:leftDrawable="@drawable/ic_back"/>
</RelativeLayout>
