<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/theme_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <me.hisn.utils.ImageTextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/theme_title_color"
                android:gravity="bottom"
                android:id="@+id/big_title_bar"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="200dp"
                android:text="@string/panel_settings_title"
                android:drawablePadding="15dp"
                app:leftDrawable="@drawable/ic_back"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_top_bkg"
                android:padding="15dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_theme_text"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/theme_type"
                    android:id="@+id/panel_theme_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_layout"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/panel_layout"
                    android:id="@+id/panel_layout_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tint_icon_text"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/panel_tint_icon_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_size"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/panel_size_array"
                    android:id="@+id/panel_size_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_alpha_text"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/panel_alpha_array"
                    android:id="@+id/panel_alpha_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_transition_animation"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/panel_anim"
                    android:id="@+id/panel_anim_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_background_text"
                    android:layout_weight="1"/>
                <Spinner
                    android:theme="@style/spinner_style"
                    android:entries="@array/panel_background"
                    android:id="@+id/panel_background_spinner"
                    android:background="@drawable/wave_bkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:textAlignment="viewEnd"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/background_color_btn"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_back_color"
                    android:layout_weight="1"/>
                <ImageView
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_expand_more"
                    android:tint="?attr/theme_text_color"
                    android:rotation="-90"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_show_in_center"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/panel_align_center_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bkg"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/show_system_volume_panel"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/show_system_volume_panel_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/zoom_in_seek_bar_on_seek"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/zoom_seek_bar_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/show_on_lock_screen"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/panel_show_on_lock_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:background="?attr/theme_item_back_color"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:src="?attr/theme_background_color"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:gravity="center"
                android:background="@drawable/item_bottom_bkg"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/panel_auto_exit"
                    android:layout_weight="1"/>
                <Switch
                    android:gravity="end"
                    android:id="@+id/panel_auto_exit_switch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <me.hisn.utils.ImageTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/theme_title_color"
        android:gravity="center_vertical"
        android:id="@+id/title_bar"
        android:background="?attr/theme_background_color"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/panel_settings_title"
        android:drawablePadding="15dp"
        android:alpha="0"
        app:leftDrawable="@drawable/ic_back"/>
</RelativeLayout>
