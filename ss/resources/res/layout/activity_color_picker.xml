<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/theme_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <me.hisn.utils.ImageTextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/theme_title_color"
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/color_egg_text"
                android:shadowColor="@color/black"
                android:drawablePadding="15dp"
                android:layout_weight="1"
                app:leftDrawable="@drawable/ic_back"/>
            <ImageView
                android:id="@+id/color_view"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/circle_shap"
                android:tint="@color/green"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/item_round_bkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#ff0000"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="5dp"/>
                <SeekBar
                    android:id="@+id/edge_shadow_red_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="0xff"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/edge_shadow_red_value"
                    android:padding="5dp"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:text="0"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#00ff00"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="5dp"/>
                <SeekBar
                    android:id="@+id/edge_shadow_green_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="0xff"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G:"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/edge_shadow_green_value"
                    android:padding="5dp"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:text="0"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#0000ff"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="5dp"/>
                <SeekBar
                    android:id="@+id/edge_shadow_blue_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="0xff"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B:"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/edge_shadow_blue_value"
                    android:padding="5dp"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:text="0"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/color_setting_alpha"
                    android:layout_weight="1"/>
                <SeekBar
                    android:id="@+id/edge_shadow_alpha_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="0xff"
                    android:layout_weight="4"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center"
                    android:id="@+id/edge_shadow_alpha_value"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="ff"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/height_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/height_text"
                    android:layout_weight="1"/>
                <SeekBar
                    android:id="@+id/touch_bar_height_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="30"
                    android:layout_weight="4"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center"
                    android:id="@+id/touch_bar_height_value"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/width_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/width_text"
                    android:layout_weight="1"/>
                <SeekBar
                    android:id="@+id/edge_shadow_width_seek"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:max="50"
                    android:layout_weight="4"/>
                <TextView
                    android:textColor="?attr/theme_text_color"
                    android:gravity="center"
                    android:id="@+id/edge_shadow_width_value"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:id="@+id/color_set_cancel_btn"
                android:background="@drawable/wave_bkg"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/cancel_text"/>
            <TextView
                android:textColor="?attr/theme_accent_color"
                android:id="@+id/color_save_btn"
                android:background="@drawable/wave_bkg"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/save_text"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/edge_shadow_img"
        android:background="@mipmap/left_light"
        android:visibility="visible"
        android:layout_width="30dp"
        android:layout_height="match_parent"/>
</RelativeLayout>
