<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/tri_in_one_parent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/tri_in_one_item_1"
        android:background="@drawable/circle_white"
        android:padding="0dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/action_home"/>
    <ImageView
        android:id="@+id/tri_in_one_item_2"
        android:background="@drawable/circle_white"
        android:padding="0dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/action_back"/>
    <ImageView
        android:id="@+id/tri_in_one_item_3"
        android:background="@drawable/circle_white"
        android:padding="0dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/action_notification"/>
</LinearLayout>
