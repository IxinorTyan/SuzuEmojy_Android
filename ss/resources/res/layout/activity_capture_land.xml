<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/capture_layout"
        android:background="@drawable/round_shape"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <me.hisn.utils.HiImageView
            android:id="@+id/capture_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:type="capture_view"/>
    </RelativeLayout>
    <View
        android:id="@+id/btn_1"
        android:background="@drawable/btn_shape_land"
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/capture_layout"
        app:layout_constraintEnd_toEndOf="@+id/capture_layout"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="@+id/capture_layout"/>
    <View
        android:id="@+id/btn_2"
        android:background="@drawable/btn_shape_land"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_above="@+id/capture_layout"
        android:layout_marginStart="30dp"
        android:layout_toEndOf="@+id/btn_1"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/capture_layout"
        app:layout_constraintStart_toEndOf="@+id/btn_1"/>
    <me.hisn.utils.DrawPadView
        android:id="@+id/draw_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:elevation="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/capture_layout"
        app:layout_constraintEnd_toEndOf="@+id/capture_layout"
        app:layout_constraintStart_toStartOf="@+id/capture_layout"
        app:layout_constraintTop_toTopOf="@+id/capture_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tool_layout"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/parent_layout"
        app:layout_constraintEnd_toEndOf="@+id/parent_layout"
        app:layout_constraintStart_toEndOf="@+id/capture_layout"
        app:layout_constraintTop_toTopOf="@+id/parent_layout">
        <ImageView
            android:id="@+id/save_shell_btn"
            android:background="@drawable/wave_bkg"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_save_black_24dp"
            android:layout_weight="1"
            android:elevation="5dp"/>
        <ImageView
            android:id="@+id/view_btn"
            android:background="@drawable/wave_bkg"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_view"
            android:layout_weight="1"
            android:elevation="5dp"/>
        <ImageView
            android:id="@+id/share_btn"
            android:background="@drawable/wave_bkg"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_share_btn"
            android:layout_weight="1"
            android:elevation="5dp"/>
        <ImageView
            android:id="@+id/delete_btn"
            android:background="@drawable/wave_bkg"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:src="@drawable/ic_delete_btn"
            android:layout_weight="1"
            android:elevation="5dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
