<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPictureRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/ui_outline"
    app:cardBackgroundColor="@color/ui_surface"
    app:rippleColor="@color/ui_accent_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 图片展示区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:background="@color/ui_thumbnail">

            <ImageView
                android:id="@+id/ivPicture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <!-- 右上角勾选 CheckBox -->
            <CheckBox
                android:id="@+id/cbSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="6dp"
                app:buttonTint="@color/ui_accent" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_outline" />

        <!-- 底部尺寸与信息 -->
        <TextView
            android:id="@+id/tvPictureInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="11sp"
            android:textColor="@color/ui_muted" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
