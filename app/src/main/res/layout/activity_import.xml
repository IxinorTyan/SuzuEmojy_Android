<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="true"
        android:clipChildren="true"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- 顶部导航栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back_24"
                    app:tint="@color/ui_ink"
                    android:padding="8dp"
                    android:contentDescription="返回" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入表情"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/ui_ink"
                        android:letterSpacing="-0.01" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持相册、文件、文件夹及资源包导入"
                        android:textSize="12sp"
                        android:textColor="@color/ui_muted"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnOpenWebShare"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_suzu_share"
                    android:padding="8dp"
                    android:contentDescription="在线表情包" />
            </LinearLayout>

            <!-- 提示说明 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择导入来源"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_muted"
                android:letterSpacing="0.04"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp" />

            <!-- 1. 从系统相册选择 -->
            <com.suzu.test.ui.components.SuzuActionCard
                android:id="@+id/btnPickImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:actionTitle="从系统相册选择"
                app:actionDetail="支持滑动多选，导入后可快速清理原图"
                app:actionIcon="@drawable/ic_home_import_add" />

            <!-- 2. 从系统文件选择 -->
            <com.suzu.test.ui.components.SuzuActionCard
                android:id="@+id/btnPickFromFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:actionTitle="从系统文件选择"
                app:actionDetail="通过系统文件管理器单选或多选图片文件"
                app:actionIcon="@drawable/ic_document_file_24" />

            <!-- 3. 从文件夹批量导入 -->
            <com.suzu.test.ui.components.SuzuActionCard
                android:id="@+id/btnPickFromFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:actionTitle="从文件夹批量导入"
                app:actionDetail="包含所有子文件夹图片，按一级子文件夹分类"
                app:actionIcon="@drawable/ic_category_default" />

            <!-- 4. 从资源包导入 -->
            <com.suzu.test.ui.components.SuzuActionCard
                android:id="@+id/btnImportFromPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:actionTitle="从资源包 (.zip) 导入"
                app:actionDetail="快速导入已备份的表情包与对应分类结构"
                app:actionIcon="@drawable/ic_export_simple" />

            <!-- 进度与导入结果反馈容器 (未开始时完全隐藏，无空高；留有阴影安全区) -->
            <LinearLayout
                android:id="@+id/layoutStatusSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导入状态与反馈"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_muted"
                    android:letterSpacing="0.04"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/ui_radius"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/ui_outline"
                    app:cardBackgroundColor="@color/ui_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="@color/ui_ink" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textColor="@color/ui_good"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                        <!-- 查看重复与失败详情按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tvViewDetailAction"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:text="查看重复与失败详情"
                            android:textSize="12sp"
                            android:textColor="@color/ui_accent"
                            app:strokeColor="@color/ui_accent"
                            app:cornerRadius="8dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
