<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_canvas"
    android:paddingHorizontal="@dimen/ui_gutter"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.Suzu.IconAction"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:srcCompat="@drawable/ic_arrow_back_24"
                    android:contentDescription="返回" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="设置"
                    android:textAppearance="@style/TextAppearance.Suzu.PageTitle" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="功能与偏好"
                android:textAppearance="@style/TextAppearance.Suzu.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Suzu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnNavKeyboardAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ui_icon"
                            android:padding="10dp"
                            android:src="@drawable/ic_about_sparkle"
                            app:tint="@color/ui_accent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="键盘设置"
                                android:textAppearance="@style/TextAppearance.Suzu.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="配置键盘样式、按键与分享白名单"
                                android:textAppearance="@style/TextAppearance.Suzu.Secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_about_chevron_right"
                            app:tint="@color/ui_subtle"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:background="@color/ui_outline" />

                    <LinearLayout
                        android:id="@+id/btnNavFloatingSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ui_icon"
                            android:padding="10dp"
                            android:src="@drawable/ic_about_chat"
                            app:tint="@color/ui_accent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="悬浮窗设置"
                                android:textAppearance="@style/TextAppearance.Suzu.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="配置快捷悬浮球与边缘手势"
                                android:textAppearance="@style/TextAppearance.Suzu.Secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_about_chevron_right"
                            app:tint="@color/ui_subtle"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="66dp"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:background="@color/ui_outline" />

                    <LinearLayout
                        android:id="@+id/btnNavOtherSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ui_icon"
                            android:padding="10dp"
                            android:src="@drawable/ic_settings_gear"
                            app:tint="@color/ui_accent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="其他设置"
                                android:textAppearance="@style/TextAppearance.Suzu.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="发送偏好和缓存清理"
                                android:textAppearance="@style/TextAppearance.Suzu.Secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_about_chevron_right"
                            app:tint="@color/ui_subtle"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. 权限状态卡片 (支持折叠/展开与状态摘要) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/ui_radius"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ui_outline"
                app:cardBackgroundColor="@color/ui_surface"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/layoutPermissionCardRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 卡片折叠/展开点击头部 -->
                    <LinearLayout
                        android:id="@+id/layoutPermissionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_home_icon_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_about_shield"
                                app:tint="@color/ui_accent"
                                android:contentDescription="权限状态" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="权限状态"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="输入法及扩展功能运行状态"
                                android:textSize="11sp"
                                android:textColor="@color/ui_muted"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- 状态摘要胶囊 -->
                        <TextView
                            android:id="@+id/tvPermissionSummaryBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查中..."
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/ui_good"
                            android:background="@drawable/bg_home_tag_green"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="6dp" />

                        <!-- 折叠/展开旋转指示箭头 -->
                        <ImageView
                            android:id="@+id/ivPermissionExpandArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_expand_more_24"
                            app:tint="@color/ui_muted"
                            android:contentDescription="折叠或展开权限详情" />
                    </LinearLayout>

                    <!-- 可折叠的详情区域 -->
                    <LinearLayout
                        android:id="@+id/layoutPermissionContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ui_surface_variant"
                            android:layout_marginBottom="12dp" />

                        <!-- 基础核心权限标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="基础核心权限"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/ui_subtle"
                            android:letterSpacing="0.04"
                            android:layout_marginBottom="4dp" />

                        <!-- 权限 1: 输入法 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvPermImeStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="输入法: 未启用"
                                android:textSize="14sp"
                                android:textColor="@color/ui_ink" />

                            <Button
                                android:id="@+id/btnPermImeAction"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textSize="12sp"
                                android:text="去设置"
                                android:textColor="@color/ui_accent"
                                app:strokeColor="@color/ui_accent"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- 权限 2: 相册读取 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvPermStorageStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="相册读取: 未授权"
                                android:textSize="14sp"
                                android:textColor="@color/ui_ink" />

                            <Button
                                android:id="@+id/btnPermStorageAction"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textSize="12sp"
                                android:text="去授权"
                                android:textColor="@color/ui_accent"
                                app:strokeColor="@color/ui_accent"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ui_surface_variant"
                            android:layout_marginVertical="10dp" />

                        <!-- 扩展权限标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="悬浮窗 / 快捷球扩展权限 (按需开启)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/ui_subtle"
                            android:letterSpacing="0.04"
                            android:layout_marginBottom="4dp" />

                        <!-- 权限 3: 悬浮窗 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvPermOverlayStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="悬浮窗: 未授权"
                                android:textSize="14sp"
                                android:textColor="@color/ui_ink" />

                            <Button
                                android:id="@+id/btnPermOverlayAction"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textSize="12sp"
                                android:text="去授权"
                                android:textColor="@color/ui_accent"
                                app:strokeColor="@color/ui_accent"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- 权限 4: 无障碍服务 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvPermA11yStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="无障碍服务: 已关闭"
                                android:textSize="14sp"
                                android:textColor="@color/ui_ink" />

                            <Button
                                android:id="@+id/btnPermA11yAction"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textSize="12sp"
                                android:text="去开启"
                                android:textColor="@color/ui_accent"
                                app:strokeColor="@color/ui_accent"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- 权限 5: 忽略电池优化 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvPermBatteryStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="忽略电池优化: 未开启"
                                android:textSize="14sp"
                                android:textColor="@color/ui_ink" />

                            <Button
                                android:id="@+id/btnPermBatteryAction"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textSize="12sp"
                                android:text="去设置"
                                android:textColor="@color/ui_accent"
                                app:strokeColor="@color/ui_accent"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- 权限 6: 自启动 / 关联启动 (厂商机型适配) -->
                        <LinearLayout
                            android:id="@+id/layoutPermAutoStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="关联启动 / 自启动"
                                        android:textSize="14sp"
                                        android:textColor="@color/ui_ink" />

                                    <TextView
                                        android:id="@+id/tvPermAutoStartSub"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="允许被其他应用唤醒，防止悬浮球服务中断"
                                        android:textSize="12sp"
                                        android:textColor="@color/ui_muted"
                                        android:layout_marginTop="2dp" />
                                </LinearLayout>

                                <Button
                                    android:id="@+id/btnPermAutoStartAction"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                    android:textSize="12sp"
                                    android:text="去设置"
                                    android:textColor="@color/ui_accent"
                                    app:strokeColor="@color/ui_accent"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="* 无障碍服务等仅用于悬浮球功能。除非需要使用悬浮球，否则不建议开启。"
                            android:textSize="11sp"
                            android:textColor="@color/ui_subtle"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="如果本软件完全无法正常使用，请检查设备是否安装了可能影响应用运行的第三方软件（如安全软件、权限管理工具、系统增强工具等）。如确认是第三方软件拦截导致，请自行关闭相关拦截或限制后再尝试使用。"
                            android:textSize="11sp"
                            android:textColor="@color/ui_subtle"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="4dp"
                            android:lineSpacingExtra="2dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/ui_surface_variant"
                            android:layout_marginVertical="10dp" />

                        <!-- 提示无障碍服务被关闭开关 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="提示无障碍服务被关闭"
                                    android:textSize="14sp"
                                    android:textColor="@color/ui_ink" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="关闭后，首页不再提示无障碍异常"
                                    android:textSize="12sp"
                                    android:textColor="@color/ui_muted"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/swNotifyWhenA11yDisabled"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="调试与支持"
                android:textAppearance="@style/TextAppearance.Suzu.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Suzu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnNavAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_ui_icon"
                            android:padding="10dp"
                            android:src="@drawable/ic_about_author"
                            app:tint="@color/ui_accent"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="关于软件"
                                android:textAppearance="@style/TextAppearance.Suzu.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
