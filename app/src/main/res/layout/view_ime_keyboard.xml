<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2B2B2B">

    <LinearLayout
        android:id="@+id/llTabHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252525"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <HorizontalScrollView
            android:id="@+id/hsvTabBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llTabBarContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/btnExit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/sel_keyboard_tab_bg"
            android:src="@drawable/ic_keyboard_collapse"
            android:scaleType="centerInside"
            android:contentDescription="收起键盘" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/flGridContainer"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#202020">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImageGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyLibraryHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="资源库为空，请在 App 内导入表情"
            android:textSize="14sp"
            android:textColor="#888888"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llSendDiagnostic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#171717"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSendDiagnosticTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发送诊断（DEBUG）"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchDebugSkipProvider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模拟未读取"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:contentDescription="模拟 Provider 未发生及未清理" />

            <Button
                android:id="@+id/btnSendDiagnosticToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="查看"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSendDiagnosticCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="复制"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/svSendDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSendDiagnosticContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#DDDDDD"
                android:textSize="10sp"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
