<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2B2B2B">

    <!-- 顶部横向滚动分类条 + 右侧固定退出按钮 (等高 56dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252525"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <HorizontalScrollView
            android:id="@+id/hsvTabBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llTabBarContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/btnExit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/sel_keyboard_tab_bg"
            android:src="@drawable/ic_keyboard_collapse"
            android:scaleType="centerInside"
            android:contentDescription="收起键盘" />
    </LinearLayout>

    <!-- 中部图片网格 与空状态提示 -->
    <FrameLayout
        android:id="@+id/flGridContainer"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#202020">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImageGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyLibraryHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="资源库为空，请在 App 内导入表情"
            android:textSize="14sp"
            android:textColor="#888888"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
