<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:padding="16dp">

    <!-- 对照组说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F5E9"
        android:padding="10dp"
        android:textColor="#2E7D32"
        android:textSize="12sp"
        android:text="【标准对照组】本页面输入框已严格实现 EditorInfoCompat.setContentMimeTypes(png/gif/jpg/webp) 及 OnCommitContentListener 回调。\n\n用于基准判定：若 TestImageIME 在此页可正常读到 4 种 MIME 并直发成功，则证明输入法实现完全正确；若 QQ 读到空 MIME 则为 QQ 自身未声明。" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="标准对照输入框 (点击拉起键盘测试):"
        android:textStyle="bold"
        android:textSize="13sp" />

    <!-- 标准对照组 EditText (唯一允许存在的 EditText) -->
    <com.suzu.test.control.RichContentEditText
        android:id="@+id/etControlInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="10dp"
        android:hint="点击这里聚焦并拉起 TestImageIME..."
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="收到 commitContent 图片预览:"
        android:textStyle="bold"
        android:textSize="13sp" />

    <!-- 接收图片展示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="6dp"
        android:background="#EEEEEE">

        <ImageView
            android:id="@+id/ivReceivedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="等待接收 commitContent 图片..."
            android:textColor="#999999"
            android:textSize="12sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvResultStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1565C0"
        android:textSize="12sp"
        android:text="接收状态: 尚未收到图片" />

    <Button
        android:id="@+id/btnBackToMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="返回主控制台" />

</LinearLayout>
