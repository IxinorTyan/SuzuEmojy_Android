<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_category_grid_item_selected">

    <ImageView
        android:id="@+id/ivCategoryIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_category_default"
        android:contentDescription="分类图标" />

    <TextView
        android:id="@+id/tvCategoryTextIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="#333333"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCategoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#333333"
        android:text="分类名称" />

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_reorder_24"
        android:tint="?attr/colorControlNormal"
        android:contentDescription="拖拽排序" />

    <TextView
        android:id="@+id/tvCategoryStatus"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:textSize="10sp"
        android:textColor="#0078D4" />

</LinearLayout>
