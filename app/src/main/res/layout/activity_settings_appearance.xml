<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="键盘外观与主题"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 键盘外观调节 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="键盘主题与布局"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- 主题选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="键盘配色主题"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginTop="12dp" />

                <RadioGroup
                    android:id="@+id/rgKeyboardTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbThemeDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="暗色主题 (默认)"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbThemeLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="亮色主题"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- 键盘高度调节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="键盘高度 (120 - 400 dp)"
                        android:textSize="14sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvHeightValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="190 dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#007AFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbKeyboardHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="280"
                    android:layout_marginTop="6dp" />

                <!-- 每行列数调节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="每行列数 (3 - 8 列)"
                        android:textSize="14sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvSpanValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 列"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#007AFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbKeyboardSpan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="5"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 键盘唤出测试与预览 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="键盘唤出测试"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击下方测试输入框可直接调起输入法，直观查看真实键盘效果"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <com.suzu.test.control.RichContentEditText
                    android:id="@+id/etTestInputBox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="点击此处呼出键盘进行测试..."
                    android:textSize="15sp"
                    android:background="#FAFAFA"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="页面内缩略预览（仅供参考）"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:id="@+id/flPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="#202020">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSettingsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="2dp"
                        android:clipToPadding="false" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
