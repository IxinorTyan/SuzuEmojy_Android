<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/pageBack" style="@style/Widget.Suzu.IconAction"
        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp"
        android:contentDescription="返回" app:srcCompat="@drawable/ic_arrow_back_24" />
    <TextView android:id="@+id/pageTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textAppearance="@style/TextAppearance.Suzu.PageTitle" />
</LinearLayout>
