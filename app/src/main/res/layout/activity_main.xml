<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_canvas"
    android:paddingHorizontal="@dimen/ui_gutter"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Suzu.PageTitle" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTopSettings"
            style="@style/Widget.Suzu.IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_settings_gear"
            android:contentDescription="设置" />
    </LinearLayout>

    <!-- 权限提示条 (条件显示，同一时刻只显示优先级最高的一条) -->
    <LinearLayout
        android:id="@+id/layoutPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_warning_modern"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="14sp"
            android:textColor="@color/ui_warning"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvWarningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输入法未启用，无法发送表情"
            android:textColor="@color/ui_warning"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWarningAction"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textColor="@color/ui_warning"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="去开启" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 首次引导：用户主动完成或跳过后隐藏 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutGuideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/ui_radius"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/ui_outline"
                app:cardBackgroundColor="@color/ui_surface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始使用 SuzuEmojy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="启用输入法后即可完成设置，其余项目可按需开启"
                    android:textSize="12sp"
                    android:textColor="@color/ui_muted"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- 步骤 1: 启用输入法 (必需) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideImeDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/ui_accent"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="启用输入法"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 必需"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_accent" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用于发送表情到各大聊天应用"
                            android:textSize="12sp"
                            android:textColor="@color/ui_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideIme"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:backgroundTint="@color/ui_accent"
                        android:text="去开启" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ui_surface_variant"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 2: 相册读取 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideStorageDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/ui_subtle"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="相册读取"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 推荐"
                                android:textSize="12sp"
                                android:textColor="@color/ui_muted" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="可授权全部或部分照片，也可稍后使用系统选择器导入"
                            android:textSize="12sp"
                            android:textColor="@color/ui_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideStorage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去授权" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ui_surface_variant"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 3: 授权悬浮窗 (可选) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideOverlayDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/ui_subtle"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="授权悬浮窗"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 可选"
                                android:textSize="12sp"
                                android:textColor="@color/ui_subtle" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用于展示快捷悬浮球"
                            android:textSize="12sp"
                            android:textColor="@color/ui_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去授权" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ui_surface_variant"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 4: 开启无障碍服务 (可选) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideA11yDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="@color/ui_subtle"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="开启无障碍服务"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/ui_ink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 可选"
                                android:textSize="12sp"
                                android:textColor="@color/ui_subtle" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="免手动切换输入法，体验更流畅"
                            android:textSize="12sp"
                            android:textColor="@color/ui_muted"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideA11y"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去开启" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* 无障碍服务仅用于悬浮球功能。除非需要使用悬浮球，否则不建议开启。"
                    android:textSize="11sp"
                    android:textColor="@color/ui_subtle"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btnGuideComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="完成并进入首页" />

                <Button
                    android:id="@+id/btnGuideDismiss"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ui_muted"
                    android:text="稍后设置，先进入首页" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 正常首页主体容器 -->
            <LinearLayout
                android:id="@+id/layoutMainHomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/cardLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ui_home_library"
                    android:foreground="?attr/selectableItemBackground"
                    android:clipToOutline="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_ui_hero_icon"
                            android:padding="10dp"
                            android:src="@drawable/ic_home_library"
                            app:tint="@color/ui_hero_ink"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="我的表情库"
                            android:textColor="@color/ui_hero_ink"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnOpenLibrary"
                            style="@style/Widget.Suzu.IconAction"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:srcCompat="@drawable/ic_about_chevron_right"
                            app:tint="@color/ui_hero_ink"
                            android:contentDescription="打开表情库" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvResourceCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/ui_hero_ink"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:textSize="34sp"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="表情总量"
                                android:textColor="@color/ui_hero_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/ui_hero_translucent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCategoryCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/ui_hero_ink"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:textSize="34sp"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="分类分组"
                                android:textColor="@color/ui_hero_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardExchange"
                        style="@style/Widget.Suzu.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/ui_accent_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="94dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_home_import_add"
                                app:tint="@color/ui_accent"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="导入导出"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/ui_ink" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSimilarity"
                        style="@style/Widget.Suzu.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="94dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_similar_images"
                                app:tint="@color/ui_accent"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="相似图片清理"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/ui_ink" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardRecentAdded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近添加"
                        android:textAppearance="@style/TextAppearance.Suzu.Section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看全部"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ui_accent" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_about_chevron_right"
                        app:tint="@color/ui_accent"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentAdded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvRecentEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="86dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ui_input"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="14dp"
                    android:text="暂无最近表情"
                    android:textAppearance="@style/TextAppearance.Suzu.Secondary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
