<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SuzuEmojy"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本地表情管理与输入法工具"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTopSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_gear"
            app:tint="#475569"
            android:padding="8dp"
            android:contentDescription="设置" />
    </LinearLayout>

    <!-- 权限提示条 (条件显示，同一时刻只显示优先级最高的一条) -->
    <LinearLayout
        android:id="@+id/layoutPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_home_warning_modern"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="14sp"
            android:textColor="#EA580C"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvWarningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输入法未启用，无法发送表情"
            android:textColor="#9A3412"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWarningAction"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textColor="#EA580C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="去开启" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 首次引导：用户主动完成或跳过后隐藏 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutGuideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始使用 SuzuEmojy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="启用输入法后即可完成设置，其余项目可按需开启"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- 步骤 1: 启用输入法 (必需) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideImeDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="启用输入法"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1E293B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 必需"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#2563EB" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用于发送表情到各大聊天应用"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideIme"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:backgroundTint="#2563EB"
                        android:text="去开启" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 2: 相册读取 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideStorageDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="相册读取"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1E293B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 推荐"
                                android:textSize="12sp"
                                android:textColor="#64748B" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="可授权全部或部分照片，也可稍后使用系统选择器导入"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideStorage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去授权" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 3: 授权悬浮窗 (可选) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideOverlayDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="授权悬浮窗"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1E293B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 可选"
                                android:textSize="12sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="用于展示快捷悬浮球"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去授权" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F1F5F9"
                    android:layout_marginVertical="6dp" />

                <!-- 步骤 4: 开启无障碍服务 (可选) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvGuideA11yDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="开启无障碍服务"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1E293B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 可选"
                                android:textSize="12sp"
                                android:textColor="#94A3B8" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="免手动切换输入法，体验更流畅"
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuideA11y"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:textSize="12sp"
                        android:text="去开启" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* 无障碍服务仅用于悬浮球功能。除非需要使用悬浮球，否则不建议开启。"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btnGuideComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="完成并进入首页" />

                <Button
                    android:id="@+id/btnGuideDismiss"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#64748B"
                    android:text="稍后设置，先进入首页" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 正常首页主体容器 -->
            <LinearLayout
                android:id="@+id/layoutMainHomeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="24dp">

                <!-- 1. 我的资源库 卡片 (真实 MaterialCardView，数据统计 + 快捷进入) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF"
                    app:rippleColor="#1A2563EB"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- 卡片头部 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_home_icon_blue">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_home_library"
                                    app:tint="#2563EB"
                                    android:contentDescription="资源库" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="我的表情库"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="本地表情管理与快速发送"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btnOpenLibrary"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_about_chevron_right"
                                app:tint="#94A3B8"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="进入管理" />
                        </LinearLayout>

                        <!-- 分割线 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"
                            android:layout_marginVertical="14dp" />

                        <!-- 统计指标栏 (表情总数 与 分类分组) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- 指标 1: 表情总数 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvResourceCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="表情总量"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="28dp"
                                android:background="#F1F5F9" />

                            <!-- 指标 2: 分组分类 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="24dp">

                                <TextView
                                    android:id="@+id/tvCategoryCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="分类分组"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. 最近添加画廊卡片 (Recent Gallery) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecentAdded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardMaxElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF"
                    app:rippleColor="#1A2563EB"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="最近添加"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="查看全部"
                                android:textSize="12sp"
                                android:textColor="#2563EB"
                                android:textStyle="bold"
                                android:layout_marginEnd="2dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_about_chevron_right"
                                app:tint="#2563EB"
                                android:contentDescription="查看全部" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecentAdded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tvRecentEmptyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingVertical="24dp"
                            android:text="暂无最近表情，点击上方导入添加"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. 核心功能操作区 (Bento 宫格: 置顶相似图片清理 + 双列导入/导出) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="功能与工具"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="管理与整理"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <!-- Bento 大卡片 1: 相似图片清理 (紧密置顶) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSimilarity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1.5dp"
                        app:cardMaxElevation="3dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        app:cardBackgroundColor="#FFFFFF"
                        app:rippleColor="#1AEA580C"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_home_icon_orange">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_similar_images"
                                    app:tint="#EA580C"
                                    android:contentDescription="相似图片清理" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="相似图片清理"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="#0F172A" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="感知哈希"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textColor="#EA580C"
                                        android:background="@drawable/bg_home_tag_orange"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="1.5dp"
                                        android:layout_marginStart="8dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="寻找相似重复表情"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_about_chevron_right"
                                app:tint="#94A3B8"
                                android:contentDescription="进入" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bento 双列卡片: 紧挨在下方，紧密排列 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp">

                        <!-- Bento 瓦片 2: 导入表情 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardImport"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1.5dp"
                            app:cardMaxElevation="3dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E2E8F0"
                            app:cardBackgroundColor="#FFFFFF"
                            app:rippleColor="#1A2563EB"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:background="@drawable/bg_home_icon_blue">

                                        <ImageView
                                            android:layout_width="18dp"
                                            android:layout_height="18dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_home_import_add"
                                            app:tint="#2563EB"
                                            android:contentDescription="导入表情" />
                                    </FrameLayout>

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="1dp"
                                        android:layout_weight="1" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="导入"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textColor="#2563EB"
                                        android:background="@drawable/bg_home_tag_blue"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="1.5dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="导入表情"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:layout_marginTop="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="从相册添加新图片"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Bento 瓦片 3: 导出资源包 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardExportPackage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1.5dp"
                            app:cardMaxElevation="3dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E2E8F0"
                            app:cardBackgroundColor="#FFFFFF"
                            app:rippleColor="#1A16A34A"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:background="@drawable/bg_home_icon_green">

                                        <ImageView
                                            android:layout_width="18dp"
                                            android:layout_height="18dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_export_simple"
                                            app:tint="#16A34A"
                                            android:contentDescription="导出资源包" />
                                    </FrameLayout>

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="1dp"
                                        android:layout_weight="1" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="备份"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textColor="#16A34A"
                                        android:background="@drawable/bg_home_tag_green"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="1.5dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="导出资源包"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:layout_marginTop="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="打包分享与安全备份"
                                    android:textSize="11sp"
                                    android:textColor="#64748B"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
