<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 顶部操作行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorControlNormal"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="资源库"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:text="共 0 张"
            android:textSize="13sp"
            android:textColor="#777777" />

        <ImageButton
            android:id="@+id/btnImport"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_import_24"
            app:tint="?attr/colorControlNormal"
            android:contentDescription="导入" />

        <ImageButton
            android:id="@+id/btnToggleSelectMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_select_multiple_24"
            app:tint="@color/icon_tint_selectable"
            android:contentDescription="多选" />
    </LinearLayout>

    <!-- 横向滚动分类条与快速选择按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <HorizontalScrollView
            android:id="@+id/svCategoryBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/llCategoryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnCategoryDropdown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_expand_more_24"
            android:contentDescription="展开分类"
            android:rotation="0" />
    </LinearLayout>

    <!-- 分类快速选择缩略图面板 -->
    <ScrollView
        android:id="@+id/svCategoryDropdown"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_category_dropdown_panel"
        android:fillViewport="true"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/glCategoryDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:padding="6dp"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false" />
    </ScrollView>

    <!-- 搜索与筛选操作行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/etSearchBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="搜索关键词或文件名..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <FrameLayout
            android:id="@+id/flFilterContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp">

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_filter"
                android:contentDescription="筛选" />

            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_filter_badge"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 网格内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLibraryGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="资源库为空，请先导入"
            android:textSize="16sp"
            android:textColor="#999999"
            android:visibility="gone" />

        <!-- 调整位置模式底部半透明提示条 -->
        <TextView
            android:id="@+id/tvSortingModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="已进入调整位置模式，按住图片或分类夹 1 秒后可拖动排序"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 底部批量操作栏 (仅多选模式可见) -->
    <LinearLayout
        android:id="@+id/llBatchActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:background="#EAEAEA"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已选 0 张"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0078D4"
            android:paddingEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnBatchSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:textSize="13sp"
            android:text="全选" />

        <Button
            android:id="@+id/btnBatchOperation"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:textSize="13sp"
            android:text="操作 ▾" />

        <Button
            android:id="@+id/btnBatchDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:textSize="13sp"
            android:textColor="#D32F2F"
            android:text="删除" />
    </LinearLayout>

</LinearLayout>
