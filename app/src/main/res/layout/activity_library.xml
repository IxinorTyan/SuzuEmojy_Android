<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/ui_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            android:id="@+id/pageHeading"
            layout="@layout/view_suzu_page_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnImport"
            style="@style/Widget.Suzu.IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_import_24"
            app:tint="@color/ui_accent"
            android:contentDescription="导入" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnToggleSelectMode"
            style="@style/Widget.Suzu.IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:srcCompat="@drawable/ic_select_multiple_24"
            app:tint="@color/icon_tint_selectable"
            android:contentDescription="多选" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_input"
            android:drawableStart="@drawable/ic_search_24"
            android:drawableTint="@color/ui_muted"
            android:drawablePadding="9dp"
            android:hint="搜索关键词，多个词用空格分隔"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/ui_ink"
            android:textColorHint="@color/ui_muted"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp" />

        <FrameLayout
            android:id="@+id/flFilterContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFilter"
                style="@style/Widget.Suzu.IconAction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ui_neutral_icon"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                app:srcCompat="@drawable/ic_filter"
                android:contentDescription="筛选" />

            <TextView
                android:id="@+id/tvFilterBadge"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_filter_badge"
                android:textColor="@color/ui_on_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <include
        android:id="@+id/categoryPicker"
        layout="@layout/view_library_category_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp" />

    <!-- 网格内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpLibraryPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="资源库为空，请先导入"
            android:textSize="16sp"
            android:textColor="@color/ui_muted"
            android:visibility="gone" />

        <!-- 调整位置模式底部半透明提示条 -->
        <TextView
            android:id="@+id/tvSortingModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="已进入调整位置模式，按住图片或分类夹 1 秒后可拖动排序"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 底部批量操作栏 (仅多选模式可见) -->
    <LinearLayout
        android:id="@+id/llBatchActionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:background="@drawable/bg_batch_action_bar"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:accessibilityLiveRegion="polite"
            android:text="0张"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchSelectAll"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_select_all"
            app:tint="@color/batch_action_icon_tint"
            android:contentDescription="全选"
            android:tooltipText="全选" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchInvertSelection"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_invert"
            app:tint="@color/batch_action_icon_tint"
            android:contentDescription="反选"
            android:tooltipText="反选" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchMoveToFront"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_top"
            app:tint="@color/batch_action_icon_tint"
            android:contentDescription="置顶"
            android:tooltipText="置顶" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchMoveToBack"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_bottom"
            app:tint="@color/batch_action_icon_tint"
            android:contentDescription="置底"
            android:tooltipText="置底" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchOperation"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_more"
            app:tint="@color/batch_action_icon_tint"
            android:contentDescription="更多操作"
            android:tooltipText="更多操作" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBatchDelete"
            android:layout_width="@dimen/batch_action_button_width"
            android:layout_height="48dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_batch_delete"
            app:tint="@color/ui_danger"
            android:contentDescription="删除"
            android:tooltipText="删除" />
    </LinearLayout>

</LinearLayout>
