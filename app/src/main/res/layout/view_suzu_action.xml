<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:padding="14dp" android:duplicateParentState="true">

    <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/bg_home_icon_accent" android:importantForAccessibility="no">
        <ImageView android:id="@+id/actionIcon" android:layout_width="22dp" android:layout_height="22dp"
            android:layout_gravity="center" app:tint="@color/ui_accent" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
        android:orientation="vertical">
        <TextView android:id="@+id/actionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Suzu.RowTitle" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/actionDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Suzu.Secondary" />
    </LinearLayout>

    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no"
        android:src="@drawable/ic_about_chevron_right" app:tint="@color/ui_subtle" />
</LinearLayout>
