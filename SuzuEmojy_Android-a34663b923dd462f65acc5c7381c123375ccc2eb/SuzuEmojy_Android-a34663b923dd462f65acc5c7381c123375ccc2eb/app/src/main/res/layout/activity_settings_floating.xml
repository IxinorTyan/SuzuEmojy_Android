<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="#444444"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="悬浮球设置"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 悬浮球总开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示悬浮球"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在其他应用上显示快捷切换按钮"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swBallMasterSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 悬浮球大小与透明度调节 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外观与尺寸"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- 悬浮球大小调节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="悬浮球大小 (40 - 80 dp)"
                        android:textSize="14sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="56 dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#007AFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbBallSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40"
                    android:layout_marginTop="6dp" />

                <!-- 悬浮球透明度调节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="不透明度 (30% - 100%)"
                        android:textSize="14sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvAlphaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80 %"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#007AFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbBallAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="70"
                    android:layout_marginTop="6dp" />

                <!-- 悬浮球动画时长调节 (0 - 200 ms, 步进 20 ms, max 10) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="渐显/渐隐动画时长 (0 - 200 ms)"
                        android:textSize="14sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvAnimDurationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 ms"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#007AFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbBallAnimDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 触发显示条件设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示触发规则"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- 开关1：仅在弹出键盘时显示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="仅在弹出键盘时显示"
                            android:textSize="14sp"
                            android:textColor="#333333" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未检测到输入法时自动隐藏悬浮球；在本应用内始终显示"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swShowOnlyWithIme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvA11yWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 需要开启无障碍服务才能检测键盘弹出"
                    android:textSize="12sp"
                    android:textColor="#E65100"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginVertical="12dp" />

            </LinearLayout>

            <!-- 悬浮球形态选择 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮球形态"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <RadioGroup
                    android:id="@+id/rgBallShape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <RadioButton
                        android:id="@+id/rbShapeCircle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="圆形"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <RadioButton
                        android:id="@+id/rbShapeRoundedRect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="圆角方形"
                        android:textSize="14sp"
                        android:textColor="#333333" />

                    <RadioButton
                        android:id="@+id/rbShapeBorderless"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="无边框"
                        android:textSize="14sp"
                        android:textColor="#333333" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvBorderlessHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 提示：请选用透明底、裁切紧密的正方形画布图片。透明区域不会误触发悬浮球，但受系统限制无法点击穿透到底层应用。请勿使用完全空的图片。"
                    android:textSize="12sp"
                    android:textColor="#007AFF"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 悬浮球外观与贴图 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮球贴图"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tvCustomImageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前外观: 默认纯色球"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSelectBallImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="从资源库选图" />

                    <Button
                        android:id="@+id/btnResetBallImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="恢复默认纯色" />
                </LinearLayout>
            </LinearLayout>

            <!-- 静态示意预览区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="实时示意预览"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:id="@+id/flPreviewBackground"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#F0F0F0">

                    <FrameLayout
                        android:id="@+id/flPreviewContainer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_floating_ball">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPreviewSkin"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <!-- 无边框模式命中区可视化遮罩（死区压暗，有效命中区镂空） -->
                        <ImageView
                            android:id="@+id/ivHitRegionOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
